{
    "family": "color",
    "settings": {
        "colorVisionMode": {
            "label": "Chart colors for CVD (color blindness)",
            "description": "Color vision deficiency simulation mode",
            "type": "'normal' | 'deutan' | 'protan' | 'tritan' | 'grayscale'",
            "default": "normal",
            "control": "radio",
            "panel": "color",
            "parentView": "controlPanel.tabs.color.colorVision",
            "keywords": ["color"]
        },
        "isDarkModeEnabled": {
            "label": "Dark mode",
            "description": "Enable dark color scheme",
            "type": "boolean",
            "default": false,
            "control": "checkbox",
            "panel": "color",
            "parentView": "controlPanel.tabs.color.colorContrast",
            "keywords": ["color"]
        },
        "contrastLevel": {
            "label": "Contrast",
            "description": "Contrast adjustment level (0-2)",
            "type": "number",
            "default": 1,
            "control": "slider",
            "controlOptions": {
                "min": 0,
                "max": 1,
                "step": 0.1,
                "percent": true,
                "compact": true
            },
            "panel": "color",
            "parentView": "controlPanel.tabs.color.colorContrast",
            "keywords": ["color"]
        },
        "colorPalette": {
            "label": "Color palette",
            "description": "Name of the color palette to use",
            "type": "string",
            "default": "diva",
            "control": "dropdown",
            "panel": "color",
            "parentView": "controlPanel.tabs.color.colorPalette",
            "keywords": ["color"]
        },
        "colorMap": {
            "description": "Comma-separated list of custom color names",
            "type": "string",
            "default": "",
            "advanced": true
        },
        "custom1": {
            "description": "Custom color 1",
            "type": "string",
            "default": ""
        },
        "custom2": {
            "description": "Custom color 2",
            "type": "string",
            "default": ""
        },
        "custom3": {
            "description": "Custom color 3",
            "type": "string",
            "default": ""
        },
        "custom4": {
            "description": "Custom color 4",
            "type": "string",
            "default": ""
        },
        "custom5": {
            "description": "Custom color 5",
            "type": "string",
            "default": ""
        },
        "custom6": {
            "description": "Custom color 6",
            "type": "string",
            "default": ""
        },
        "custom7": {
            "description": "Custom color 7",
            "type": "string",
            "default": ""
        },
        "custom8": {
            "description": "Custom color 8",
            "type": "string",
            "default": ""
        }
    }
}