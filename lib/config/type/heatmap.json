{
    "ref": "type.plane",
    "family": "heatmap",
    "settings": {
        "resolution": {
            "label": "Resolution",
            "description": "Grid resolution for heat map",
            "type": "number",
            "default": 20,
            "control": "textfield",
            "controlOptions": {
                "inputType": "number",
                "min": 5,
                "max": 100
            },
            "parentView": "controlPanel.tabs.chart.chart"
        },
        "xFacet": {
            "label": "X Facet",
            "description": "Axis to group on the X axis",
            "type": "string",
            "default": "",
            "control": "dropdown",
            "parentView": "controlPanel.tabs.chart.chart"
        },
        "yFacet": {
            "label": "Y Facet",
            "description": "Axis to group on the Y axis",
            "type": "string",
            "default": "",
            "control": "dropdown",
            "parentView": "controlPanel.tabs.chart.chart"
        }
    }
}