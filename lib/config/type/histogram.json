{
    "ref": "type.plane",
    "family": "histogram",
    "settings": {
        "bins": {
            "label": "Bins",
            "description": "Number of bins for grouping data",
            "type": "number",
            "default": 20,
            "control": "textfield",
            "controlOptions": {
                "inputType": "number",
                "min": 5,
                "max": 100
            },
            "parentView": "controlPanel.tabs.chart.chart"
        },
        "displayAxis": {
            "label": "Axis to display histogram:",
            "description": "Which axis shows the histogram bars",
            "type": "string",
            "default": "x",
            "control": "dropdown",
            "controlOptions": {
                "options": ["x", "y"]
            },
            "parentView": "controlPanel.tabs.chart.chart"
        },
        "groupingAxis": {
            "label": "Axis to group:",
            "description": "Which axis is used for grouping",
            "type": "string",
            "default": "",
            "control": "dropdown",
            "parentView": "controlPanel.tabs.chart.chart"
        },
        "relativeAxes": {
            "label": "Show counts vs percentages:",
            "description": "Show counts or percentages",
            "type": "'Counts' | 'Percentage'",
            "default": "Counts",
            "control": "dropdown",
            "controlOptions": {
                "options": ["Counts", "Percentage"]
            },
            "parentView": "controlPanel.tabs.chart.chart"
        }
    }
}