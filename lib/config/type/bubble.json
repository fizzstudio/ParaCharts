{
    "ref": "type.plane",
    "family": "bubble",
    "settings": {
        "xFacet": {
            "label": "cpanel.tabs.chart.bubble_x_facet",
            "description": "Facet to display on the X axis",
            "type": "string",
            "default": "",
            "control": "dropdown",
            "parentView": "controlPanel.tabs.chart.chart"
        },
        "yFacet": {
            "label": "cpanel.tabs.chart.bubble_y_facet",
            "description": "Facet to display on the Y axis",
            "type": "string",
            "default": "",
            "control": "dropdown",
            "parentView": "controlPanel.tabs.chart.chart"
        },
        "bubbleFacet": {
            "label": "cpanel.tabs.chart.bubble_bubble_facet",
            "description": "Facet to use for bubble size",
            "type": "string",
            "default": "",
            "control": "dropdown",
            "parentView": "controlPanel.tabs.chart.chart"
        },
        "labelFacet": {
            "label": "cpanel.tabs.chart.bubble_label_facet",
            "description": "Facet to use for as labels",
            "type": "string",
            "default": "",
            "control": "dropdown",
            "parentView": "controlPanel.tabs.chart.chart"
        },
        "maxBubbleSize": {
            "label": "cpanel.tabs.chart.bubble_max_bubble_size",
            "description": "Max bubble size",
            "type": "number",
            "default": 4,
            "control": "slider",
            "controlOptions": {
                "min": 1.1,
                "max": 10,
                "step": 0.1,
                "percent": true,
                "compact": true
            },
            "parentView": "controlPanel.tabs.chart.chart"
        },
        "minBubbleSize": {
            "label": "cpanel.tabs.chart.bubble_min_bubble_size",
            "description": "Min bubble size",
            "type": "number",
            "default": 0.75,
            "control": "slider",
            "controlOptions": {
                "min": 0.1,
                "max": 0.9,
                "step": 0.1,
                "percent": true,
                "compact": true
            },
            "parentView": "controlPanel.tabs.chart.chart"
        }
    }
}