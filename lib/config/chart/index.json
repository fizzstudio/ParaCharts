{
    "family": "chart",
    "settings": {
        "type": {
            "description": "The type of chart to display",
            "type": "ChartType",
            "default": "bar"
        },
        "width": {
            "label": "Width",
            "description": "Chart width in pixels",
            "type": "number",
            "default": 600,
            "control": "textfield",
            "controlOptions": {
                "inputType": "number",
                "min": 1,
                "max": 1000
            },
            "panel": "chart",
            "parentView": "controlPanel.tabs.chart.general.width"
        },
        "height": {
            "label": "Height",
            "description": "Chart height in pixels",
            "type": "number",
            "default": 450,
            "control": "textfield",
            "controlOptions": {
                "inputType": "number",
                "min": 1,
                "max": 1000
            },
            "panel": "chart",
            "parentView": "controlPanel.tabs.chart.general.height"
        },
        "orientation": {
            "description": "Which direction is 'up' on the chart",
            "type": "CardinalDirection",
            "default": "north"
        },
        "padding": {
            "description": "Padding around chart content (CSS format)",
            "type": "string",
            "default": "8 30"
        },
        "fontFamily": {
            "description": "Font family for all chart text",
            "type": "string",
            "default": "Helvetica, sans-serif"
        },
        "fontWeight": {
            "description": "Font weight for chart text",
            "type": "string",
            "default": "300"
        },
        "fontScale": {
            "label": "Font scale",
            "description": "Global font size multiplier",
            "type": "number",
            "default": 1,
            "control": "slider",
            "controlOptions": {
                "min": 0.5,
                "max": 3,
                "step": 0.1,
                "showValue": true
            },
            "panel": "chart",
            "parentView": "controlPanel.tabs.chart.fonts"
        },
        "stroke": {
            "description": "Stroke color for lines and shapes",
            "type": "string",
            "default": "purple"
        },
        "strokeWidth": {
            "description": "Stroke width in pixels",
            "type": "number",
            "default": 4
        },
        "strokeHighlightScale": {
            "description": "Scale factor for highlighted strokes",
            "type": "number",
            "default": 1.5
        },
        "symbolStrokeWidth": {
            "description": "Stroke width for symbols in pixels",
            "type": "number",
            "default": 2
        },
        "symbolHighlightScale": {
            "description": "Scale factor for highlighted symbols",
            "type": "number",
            "default": 1.5
        },
        "hasDirectLabels": {
            "description": "Show direct labels on data points",
            "type": "boolean",
            "default": true
        },
        "directLabelFontSize": {
            "description":  "Font size for direct labels",
            "type": "string",
            "default": "10pt"
        },
        "hasLegendWithDirectLabels": {
            "description": "Show legend when direct labels are present",
            "type": "boolean",
            "default": false
        },
        "isDrawSymbols": {
            "label": "Show symbols",
            "description": "Draw symbols at data points",
            "type": "boolean",
            "default": true,
            "control": "checkbox",
            "parentView": "controlPanel.tabs.chart.chart"
        },
        "isStatic": {
            "description": "Disable all interactivity",
            "type": "boolean",
            "default": false
        },
        "isShowVisitedDatapointsOnly": {
            "description": "Only show data points that have been visited",
            "type": "boolean",
            "default": false
        },
        "isShowPopups": {
            "label": "Show popups",
            "description": "Show popups on hover or focus",
            "type": "boolean",
            "default": false,
            "control": "checkbox",
            "parentView": "controlPanel.tabs.chart.popups"
        },
        "maxError": {
            "description": "Max allowable error in first pass of segmentation algorithm",
            "type": "number",
            "default": 0.01
        },
        "maxSegments": {
            "description": "Max allowable segments in second pass of segmentation algorithm",
            "type": "number",
            "default": 4
        },
        "extremumWeight": {
            "description": "Additional weight given to \"peaks and valleys\" during segmentation",
            "type": "number",
            "default": 10
        }

    }
}