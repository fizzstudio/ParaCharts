{
    "family": "animation",
    "settings": {
        "isAnimationEnabled": {
            "label": "cpanel.tabs.controls.animation",
            "description": "Enable chart animations",
            "type": "boolean",
            "default": false,
            "control": "checkbox",
            "parentView": "controlPanel.tabs.controls.animation"
        },
        "animateRevealTimeMs": {
            "label": "cpanel.tabs.controls.anim_dialog.animation_rate",
            "description": "Duration for main chart reveal animation in milliseconds",
            "type": "number",
            "default": 2500,
            "control": "textfield",
            "controlOptions": {
                "inputType": "number",
                "min": 0,
                "max": 10000
            },
            "parentView": "controlPanel.tabs.controls.dialog.animation"
        },
        "popInAnimateRevealTimeMs": {
            "description": "Duration for symbol pop-in animation in milliseconds",
            "type": "number",
            "default": 750
        },
        "animationType": {
            "label": "cpanel.tabs.controls.anim_dialog.animation_type",
            "description": "Which axis to animate along",
            "type": "AnimationType",
            "default": "yAxis",
            "control": "radio",
            "controlOptions": {
                "buttons": {
                    "yAxis": {
                        "label": "Y-axis"
                    },
                    "xAxis": {
                        "label": "X-axis"
                    }
                },
                "layout": "horiz"
            },
            "parentView": "controlPanel.tabs.controls.dialog.animation"
        },
        "animationOrigin": {
            "label": "cpanel.tabs.controls.anim_dialog.animation_origin",
            "description": "Starting point for animations",
            "type": "AnimationOrigin",
            "default": "initialValue",
            "control": "radio",
            "controlOptions": {
                "buttons": {
                    "baseline": {
                        "label": "Bottom"
                    },
                    "top": {
                        "label": "Top"
                    },
                    "initialValue": {
                        "label": "Initial Value"
                    },
                    "custom": {
                        "label": "Custom"
                    }
                },
                "layout": "horiz"
            },
            "parentView": "controlPanel.tabs.controls.dialog.animation"

        },
        "animationOriginValue": {
            "label": "cpanel.tabs.controls.anim_dialog.animation_origin_value",
            "description": "Custom value for animation origin when set to 'custom'",
            "type": "number",
            "default": 0,
            "control": "textfield",
            "controlOptions": {
                "inputType": "number",
                "min": 0,
                "max": 10000
            },
            "parentView": "controlPanel.tabs.controls.dialog.animation"
        }
    }
}