{
    "start": {
        "layer": "series",
        "if": "sonificationIsEnabled",
        "else": "eachSeriesDatapoints"
    },
    "layers": [
        {
            "id": "series"
        },
        {
            "id": "eachSeriesDatapoints"
        },
        {
            "id": "sequences"
        }
    ],
    "transitions": [
        {
            "from": "series",
            "to": "eachSeriesDatapoints",
            "dir": "right",
            "mode": "eachToFirstOfRelated"
        },
        {
            "from": "datapoints",
            "to": "sequences",
            "mode": "trendPointToTrend"
        }
    ]
}