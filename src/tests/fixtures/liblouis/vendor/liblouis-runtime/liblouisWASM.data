space \t 9 tab
space \x001b 1b escape character for html back-translation
space \x00A0 a NO-BREAK SPACE <noBreak> 0020 NON-BREAKING SPACE

noback correct "\x200b" "\s"

include text_nabcc.dis
include spaces.uti

include latinLetterDef6Dots.uti
include latinUppercaseComp6.uti


#   Modifiers

# acute accent
sign \x00b4 45-34 ´
sign \x0301 45-34 ́ 
noback correct [$l]"́" "́"*

# circumflex/carot
sign \x005e 4-26 ^
sign \x0302 45-146 ̂ 
noback correct [$l]"̂" "̂"*

# grave accent
sign \x0060 46-16 `
noback punctuation ` 4
sign \x0300 45-16 ̀̀ 
noback correct [$l]"̀" "̀"*

# tilde
math \x007e 4-35 ~
sign \x0303 45-12456 ̃ 
noback correct [$l]"̃" "̃"*
noback pass2 @45-12456-6 @6-45-12456  move after capital sign

# macron
sign \x00af 4-36 ¯
sign \x0304 45-4-36 ̄ 
noback correct [$l]"̄" "̄"*

# cedilla
sign \x00b8 45-12346 ¸
sign \x0327 45-12346 ̧ 
noback correct [$l]"̧" "̧"*

# diaeresis/umlat
sign \x00a8 45-25 ¨
sign \x0308 45-25 ̈  
noback correct [$l]"̈" "̈"*

# caron
sign \x02c7 45-345 ˇ
sign \x030c 45-346 ̌ 
noback correct [$l]"̌" "̌"*

# breve
sign \x02d8 4-346 ˘
sign \x0306 4-346 ̆ 
noback correct [$l]"̆" "̆"*

# ring/circle
sign \x02da 45-1246 ˚
sign \x030a 45-1246 ̊  
noback correct [$l]"̊" "̊"*


#####   Start of Unicode


#   Unicode:  Basic Latin

punctuation ! 235
nofor postpunc ! 235
match %a ! %a 56-235

punctuation " 6-2356
# The "?" symbol is mostly handled below,
# but the pattern needs to be defined before prepunc and postpunc can be used.
nofor punctuation ? 236
nofor punctuation " 356
nofor prepunc " 236
nofor postpunc " 356
match %[^_~]%<* " %[_.$]*%[a#] 236
match %[a#]%[_.$]* " %>*%[^_~] 356

sign # 456-1456
sign $ 4-234
sign % 46-356
sign & 4-12346
punctuation ' 3
punctuation ( 5-126
nofor prepunc ( 5-126
punctuation ) 5-345
postpunc ) 5-345
sign * 5-35
math + 5-235
punctuation , 2
nofor postpunc , 2
match %a , %a 56-2
punctuation - 36
hyphen - 36
punctuation . 256
nofor postpunc . 256
math / 456-34
# 0-9   see Numeric Symbols
punctuation : 25
postpunc : 25
match %a : %a 56-25
punctuation ; 23
postpunc ; 23
match %a ; %a 56-23
math < 4-126
math = 5-2356
punctuation > 4-345
# requires grade one indicator when by itself
punctuation ? 56-236
postpunc ? 236
sign @ 4-1
# A-Z   see latinLetterDef8Dots.uti
punctuation [ 46-126
nofor prepunc [ 46-126
sign \\ 456-16
punctuation ] 46-345
nofor postpunc ] 46-345
# \x005e ^   see Modifiers
sign _ 46-36
# /x0060 `   see Modifiers
# a-z   see latinLetterDef8Dots.uti
punctuation { 456-126
nofor prepunc { 456-126
sign | 456-1256 
punctuation } 456-345
nofor postpunc } 456-345
# \x007e ~   see Modifiers


