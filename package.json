  },
  "bugs": {
    "url": "https://github.com/fizzstudio/paracharts/issues"
  },
  "homepage": "https://github.com/fizzstudio/paracharts#readme",
  "type": "module",
  "scripts": {
    "dev": "storybook dev --no-open -p 5180",
    "go": "npm i && storybook dev --no-open -p 5180",
    "demo:headless": "vite --port 5177",
    "demo:ai": "vite --port 5178 --open src/demo/ai/ai.html",
    "demo:short": "vite --port 5183 --open src/demo/short-desc/short.html",
    "demo:poll": "vite --port 5199 --config src/demo/poll/vite.config.ts",
    "demo:live_update": "vite --port 5200 --open src/demo/live_update/index.html",
    "demo:live_update_multi": "vite --port 5201 --open src/demo/live_update_multi/index.html",
    "demo:live_feed": "vite --port 5202 --open src/demo/live_feed/index.html",
    "storybook": "storybook dev -p 5180",
    "build": "rimraf dist && rimraf types && tsc && vite build && api-extractor run --local --verbose",
    "build:ai": "rimraf dist-ai && rimraf types-ai && tsc --project ai.tsconfig.json && vite build --config ai.vite.config.ts && api-extractor run --local --verbose --config ai.api-extractor.json",
    "build:stories": "node src/stories/storiesBuilder.ts",
    "build-storybook": "storybook build",
    "prepack": "npm run build",
    "config:generate": "python3 lib/config/build_settings.py lib/config",
    "docs:api-model": "tsx ./docs/scripts/stageApiModel.ts ./temp/paracharts.api.json ./docs/.api-model",
    "docs:api": "npm run docs:api-model && rimraf docs/.api-staging && api-documenter markdown --input-folder ./docs/.api-model --output-folder ./docs/.api-staging && tsx ./docs/scripts/prepareApiDocs.ts docs/.api-staging && tsx ./docs/scripts/replaceGeneratedDir.ts docs/.api-staging docs/api",
    "docs:pages": "tsx ./docs/scripts/buildDocs.ts",
    "test:unit": "vitest run --project=unit",
    "test:browser": "vitest run --project=browser",
    "test:watch": "vitest watch",
    "pubalpha": "npm version prerelease --preid alpha && npm publish --tag alpha",
    "pubpatch": "npm version patch && npm publish",
    "pubminor": "npm version minor && npm publish",
    "pubmajor": "npm version major && npm publish",
    "docs:generate": "npm run config:generate && tsc && api-extractor run --local --verbose && npm run docs:api && npm run docs:pages",
    "docs:check": "git diff --exit-code -- lib/config/config_defaults.ts lib/config/config_metadata.ts lib/config/config_types.ts etc/paracharts.api.md etc/paracharts.ai.api.md",
    "docs:dev": "npm run docs:generate && vitepress dev docs",
    "docs:build": "npm run docs:generate && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/paracharts.js",
    "./stylesheet": "./dist/style.css"
  },
  "types": "./dist/paracharts.d.ts",
  "devDependencies": {
    "@fizz/chart-data": "^2.5.10",
    "@fizz/test-utils": "^0.2.0",
    "@microsoft/api-documenter": "^7.25.11",
    "@microsoft/api-extractor": "^7.47.6",
    "@microsoft/api-extractor-model": "^7.33.10",
    "@storybook/addon-coverage": "^2.0.0",
    "@storybook/addon-links": "^9.0.13",
    "@storybook/addon-vitest": "^9.0.13",
    "@storybook/test-runner": "^0.23.0",
    "@storybook/web-components-vite": "^9.0.13",
    "@types/mustache": "^4.2.6",
    "@types/papaparse": "^5.3.16",
    "@vitest/browser": "3.2.4",
    "@vitest/coverage-v8": "3.2.4",
    "eslint-plugin-storybook": "^9.0.13",
    "happy-dom": "^20.3.1",
    "mustache": "^4.2.0",
    "playwright": "^1.54.1",
    "printf": "^0.6.1",
    "rimraf": "^6.0.1",
    "shadow-dom-testing-library": "^1.12.0",
    "storybook": "^9.0.13",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vite": "^5.4.0",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@elemental/localization": "^1.10.0",
    "@fizz/chart-classifier-utils": "^0.17.0",
    "@fizz/clustering": "^0.16.0",
    "@fizz/dataframe": "^0.27.2",
    "@fizz/jimerator": "^0.20.1",
    "@fizz/logger": "^0.1.0",
    "@fizz/number-scaling-rounding": "^0.6.1",
    "@fizz/paramanifest": "^0.12.1",
    "@fizz/paramodel": "^0.8.22",
    "@fizz/parasummary": "^0.17.3",
    "@fizz/simple-statistics": "^7.10.0",
    "@fizz/sparkbraille-component": "^0.5.0",
    "@fizz/templum": "^0.5.9",
    "@fizz/ui-components": "^0.73.0",
    "@lit-app/state": "^1.0.1",
    "decimal.js": "^10.4.3",
    "immer": "^10.1.1",
    "lit": "^3.2.0",
    "papaparse": "^5.5.3",
    "typescript-memoize": "^1.1.1"
  },
  "packageManager": "npm@10.9.8",
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
